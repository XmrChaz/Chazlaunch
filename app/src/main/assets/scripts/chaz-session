#!/bin/sh
# chaz-session — launch a nested full-desktop Wayland session (Hyprland / Sway /
# labwc) as a single Android task, connected to the Chazlaunch compositor.
#
# Unlike the default model (each Linux window = its own Android task), a session
# paints a whole tiling desktop into ONE surface. It is installed on demand via
# Nix. There is no GPU under rootless PRoot, so it runs on software rendering
# (wlroots pixman backend) — fine for Sway/labwc, heavier for Hyprland.
#
#   chaz-session sway | hyprland | labwc
set -u

wm="${1:-$(cat /root/.config/chaz-wm 2>/dev/null || echo sway)}"

export NIX_CONFIG="experimental-features = nix-command flakes"
export PATH="/root/.nix-profile/bin:/run/current-system/sw/bin:/root/.local/bin:$PATH"
export NIX_REMOTE=   # standalone (no daemon under PRoot)
for c in /etc/ssl/certs/ca-bundle.crt /etc/ssl/certs/ca-certificates.crt \
         "$(ls -1 /nix/store/*-nss-cacert-*/etc/ssl/certs/ca-bundle.crt 2>/dev/null | head -1)"; do
    [ -n "$c" ] && [ -r "$c" ] && { export NIX_SSL_CERT_FILE="$c" SSL_CERT_FILE="$c"; break; }
done
export XDG_RUNTIME_DIR=/run/user/0
export WAYLAND_DISPLAY=wayland-0
export XDG_SESSION_TYPE=wayland
# wlroots: nest on the parent Wayland (our compositor), software-render.
export WLR_BACKENDS=wayland
export WLR_RENDERER=pixman
export WLR_NO_HARDWARE_CURSORS=1
export LIBGL_ALWAYS_SOFTWARE=1

# Map friendly name -> nixpkgs attr + binary.
case "$wm" in
    hyprland|Hyprland) pkg="hyprland"; bin="Hyprland" ;;
    sway)              pkg="sway";     bin="sway" ;;
    labwc)             pkg="labwc";    bin="labwc" ;;
    *)                 pkg="$wm";      bin="$wm" ;;
esac

if ! command -v "$bin" >/dev/null 2>&1; then
    echo "[chaz-session] installing $pkg …"
    nix profile install "nixpkgs#$pkg" || { echo "[chaz-session] install failed"; exit 1; }
fi

# Seed a sensible default config so the nested desktop isn't blank and has
# touch-friendly keybinds (Super = Mod4). A terminal autostarts on login.
case "$wm" in
    sway)
        mkdir -p /root/.config/sway
        if [ ! -f /root/.config/sway/config ]; then
            cat > /root/.config/sway/config <<'EOF'
# Chazlaunch default sway config
set $mod Mod4
set $term foot
default_border pixel 2
gaps inner 6
exec $term
bindsym $mod+Return exec $term
bindsym $mod+d exec foot -e /root/.local/bin/chaz-pkg
bindsym $mod+q kill
bindsym $mod+e exit
# Software cursor so it shows without a GPU.
seat * hide_cursor when-typing enable
EOF
        fi
        ;;
    labwc)
        mkdir -p /root/.config/labwc
        [ -f /root/.config/labwc/autostart ] || printf 'foot &\n' > /root/.config/labwc/autostart
        ;;
    hyprland|Hyprland)
        mkdir -p /root/.config/hypr
        if [ ! -f /root/.config/hypr/hyprland.conf ]; then
            cat > /root/.config/hypr/hyprland.conf <<'EOF'
# Chazlaunch default Hyprland config (software rendering)
exec-once = foot
bind = SUPER, RETURN, exec, foot
bind = SUPER, Q, killactive
bind = SUPER, M, exit
EOF
        fi
        ;;
esac

echo "[chaz-session] starting $bin (nested, software-rendered)…"
if command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session "$bin"
else
    exec "$bin"
fi
